#!/bin/bash
# Áudio Bluetooth do CodeOS (serviço de usuário): junta todas as saídas Bluetooth numa só ("Bluetooth
# Headphones (combined)"), para dois fones tocarem o mesmo som ao mesmo tempo.
#
# Fone só conecta (e desconecta) quando o usuário clica: este serviço não mexe em conexão nenhuma. Antes
# ele reconectava os que caíam e os da sessão anterior, e refazia a conexão de um fone "conectado sem
# áudio" — com dois fones isso derrubava o segundo: enquanto o WirePlumber ainda acertava o codec dele, o
# serviço via o fone sem saída de som e o desconectava. O BlueZ também não reconecta sozinho
# (ReconnectAttempts=0 em main.conf).
#
# A saída combinada (com compensação de atraso, para os fones ficarem juntos mesmo quando um responde
# mais devagar) é refeita quando muda a lista de saídas Bluetooth, inclusive quando uma saída é
# recriada com o mesmo nome (reinício do WirePlumber, fone que cai e volta): pelo nome o combine
# continuava apontando para a saída antiga e o som parava.
set -u
SINK=bluetooth_headphones_combined
NOME_ANTIGO=fones_juntos_agora  # versões anteriores do CodeOS
# o pipewire-pulse só aceita espaços no nome com as aspas de fora (') e as de dentro (") juntas
DESCRICAO="Bluetooth Headphones (combined)"

ultimo=""

combines() {  # módulos combine-sink deste serviço (o atual e o de versões anteriores)
    pactl list short modules 2>/dev/null |
        awk -v a="sink_name=$SINK" -v b="sink_name=$NOME_ANTIGO" \
            '$2=="module-combine-sink" && (index($0,a) || index($0,b)) {print $1}'
}

while true; do
    # "id:nome" de cada saída Bluetooth: muda quando entra ou sai um fone e quando uma saída é recriada
    atual=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_output\./ {print $1 ":" $2}' | sort | paste -sd,)
    if [ "$atual" != "$ultimo" ] || { [ -n "$atual" ] && ! pactl list short sinks | grep -q "	$SINK	"; }; then
        combines | xargs -r -n1 pactl unload-module
        if [ -n "$atual" ]; then
            nomes=$(tr ',' '\n' <<<"$atual" | cut -d: -f2- | paste -sd,)
            pactl load-module module-combine-sink sink_name=$SINK \
                "sink_properties='device.description=\"$DESCRICAO\"'" slaves="$nomes" latency_compensate=yes >/dev/null &&
                pactl set-default-sink $SINK
        fi
        ultimo=$atual
    fi
    sleep 5
done
