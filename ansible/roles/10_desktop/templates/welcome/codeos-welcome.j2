    def secao(self, titulo, descricao, conteudo):
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=8)
        caixa.pack_start(rotulo(titulo, xalign=0), False, False, 0)
        if descricao:
            caixa.pack_start(rotulo(descricao, "subtitulo", xalign=0, wrap=True), False, False, 0)
        conteudo.set_margin_top(4)
        caixa.pack_start(conteudo, False, False, 0)
        return caixa

    def botao_tarefa(self, texto, pronto, comando):
        """Botão que roda um comando em segundo plano; vira "✓ texto" quando termina bem."""
        pilha = Gtk.Stack()
        botao = Gtk.Button(label=texto)
        girando = Gtk.Box(spacing=6)
        girando.pack_start(Gtk.Spinner(active=True), False, False, 0)
        girando.pack_start(rotulo(texto), False, False, 0)
        feito = rotulo("✓ " + texto, "subtitulo")
        pilha.add_named(botao, "botao")
        pilha.add_named(girando, "girando")
        pilha.add_named(feito, "pronto")
        pilha.show_all()
        pilha.set_visible_child_name("pronto" if pronto else "botao")

        def rodar(_b):
            pilha.set_visible_child_name("girando")
            try:
                proc = Gio.Subprocess.new(comando, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
            except GLib.Error as e:
                pilha.set_visible_child_name("botao")
                self.erro(texto, e.message)
                return

            def fim(p, r):
                try:
                    _ok, saida, _e = p.communicate_utf8_finish(r)
                except GLib.Error as e:
                    saida = e.message
                if p.get_exit_status() == 0:
                    pilha.set_visible_child_name("pronto")
                else:
                    pilha.set_visible_child_name("botao")
                    if p.get_exit_status() not in (126, 127):
                        self.erro(texto, (saida or "").strip()[-600:])

            proc.communicate_utf8_async(None, None, fim)

        botao.connect("clicked", rodar)
        return pilha

    def criar_chave(self, email, criar, copiar):
        d = Gtk.Dialog(title=t("New SSH key", "Nova chave SSH"), transient_for=self, modal=True)
        d.add_button(t("_Cancel", "_Cancelar"), Gtk.ResponseType.CANCEL)
        d.add_button(t("C_reate", "C_riar"), Gtk.ResponseType.OK)
        area = d.get_content_area()
        area.set_spacing(8)
        area.set_border_width(12)
        area.add(rotulo(t("Optional passphrase (asked when the key is used):",
                          "Senha opcional da chave (pedida quando ela for usada):"), xalign=0))
        senha = Gtk.Entry(visibility=False, activates_default=True)
        area.add(senha)
        d.set_default_response(Gtk.ResponseType.OK)
        d.show_all()
        resposta = d.run()
        frase = senha.get_text()
        d.destroy()
        if resposta != Gtk.ResponseType.OK:
            return
        os.makedirs(os.path.dirname(CHAVE_SSH), mode=0o700, exist_ok=True)
        r = subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", frase, "-C", email or os.environ.get("USER", ""),
                            "-f", CHAVE_SSH], capture_output=True, text=True)
        if r.returncode != 0:
            self.erro(t("SSH key", "Chave SSH"), r.stderr.strip())
            return
        criar.set_sensitive(False)
        copiar.set_sensitive(True)
        self.copiar_chave()

    def copiar_chave(self):
        try:
            with open(CHAVE_SSH + ".pub") as f:
                chave = f.read().strip()
        except OSError:
            return
        Gtk.Clipboard.get_default(self.get_display()).set_text(chave, -1)
        self.estado_ssh.set_text(t("Public key copied — paste it on GitHub", "Chave pública copiada — cole no GitHub"))

    def docker_sem_sudo(self, botao):
        querer = botao.get_active()
        if querer == no_grupo_docker():
            return
        if querer:
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                  text=t("Use Docker without sudo?", "Usar o Docker sem sudo?"))
            d.format_secondary_text(t(
                "Docker without sudo gives this account the same power as an administrator: any container can "
                "read and change the whole system. It takes effect after logging out and in again.",
                "Docker sem sudo dá a esta conta o mesmo poder de um administrador: qualquer container pode ler "
                "e mudar o sistema inteiro. Vale depois de sair e entrar de novo na sessão."))
            d.add_button(t("_Cancel", "_Cancelar"), Gtk.ResponseType.CANCEL)
            d.add_button(t("_Allow", "_Permitir"), Gtk.ResponseType.ACCEPT)
            ok = d.run() == Gtk.ResponseType.ACCEPT
            d.destroy()
            if not ok:
                botao.set_active(False)
                return
        r = subprocess.run(["pkexec", AJUDANTE, "docker-on" if querer else "docker-off"])
        if r.returncode != 0:
            botao.handler_block_by_func(self.docker_sem_sudo)
            botao.set_active(not querer)
            botao.handler_unblock_by_func(self.docker_sem_sudo)

    # ── instalação ───────────────────────────────────────────────────────────────────────────

    def instalar(self, ident, nome, como, direita):
        if ident == "ms-fonts" and not self.aceitar_licenca():
            return
        direita.set_visible_child_name("girando")
        try:
            processo = Gio.Subprocess.new(["pkexec", AJUDANTE, ident],
                                          Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            self.erro(nome, e.message)
            direita.set_visible_child_name("botao")
            return

        def terminou(proc, resultado):
            try:
                _ok, saida, _err = proc.communicate_utf8_finish(resultado)
            except GLib.Error as e:
                saida = e.message
            if instalado(como):
                direita.set_visible_child_name("pronto")
            else:
                direita.set_visible_child_name("botao")
                # 126/127: a pessoa cancelou a senha; aí não é erro
                if proc.get_exit_status() not in (126, 127):
                    self.erro(nome, (saida or "").strip()[-600:])

        processo.communicate_utf8_async(None, None, terminou)

    def aceitar_licenca(self):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              text=t("Microsoft's license", "Licença da Microsoft"))
        d.format_secondary_text(LICENCA_FONTES)
        d.get_message_area().pack_start(Gtk.LinkButton(uri=URL_LICENCA_FONTES,
                                                       label=t("Read the license", "Ler a licença")),
                                        False, False, 0)
        d.add_button(t("_Cancel", "_Cancelar"), Gtk.ResponseType.CANCEL)
        d.add_button(t("_Accept and install", "_Aceitar e instalar"), Gtk.ResponseType.ACCEPT)
        d.show_all()
        resposta = d.run()
        d.destroy()
        return resposta == Gtk.ResponseType.ACCEPT

    def erro(self, nome, detalhe):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE,
                              text=t(f"Could not install {nome}", f"Não foi possível instalar {nome}"))
        d.format_secondary_text(detalhe or t("Check the internet connection and try again.",
                                             "Confira a conexão com a internet e tente de novo."))
        d.run()
        d.destroy()


def main():
    if "--autostart" in sys.argv and not mostrar_ao_iniciar():
        return
    janela = BoasVindas()
    janela.connect("destroy", Gtk.main_quit)
    janela.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
