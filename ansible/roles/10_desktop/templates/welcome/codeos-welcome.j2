def git_config(chave):
    r = subprocess.run(["git", "config", "--global", chave], capture_output=True, text=True)
    return r.stdout.strip()


def gh_conectado():
    try:
        return subprocess.run(["gh", "auth", "status"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def mise_globais():
    try:
        r = subprocess.run(["mise", "ls", "--global", "--json"], capture_output=True, text=True, timeout=10)
        import json
        return set(json.loads(r.stdout or "{}").keys())
    except (OSError, subprocess.SubprocessError, ValueError):
        return set()


def no_grupo_docker():
    import grp
    try:
        return os.environ.get("USER", "") in grp.getgrnam("docker").gr_mem
    except KeyError:
        return False


def arquivos_ocultos():
    r = subprocess.run(["xfconf-query", "-c", "thunar", "-p", "/last-show-hidden"], capture_output=True, text=True)
    return r.stdout.strip() == "true"


def mostrar_ao_iniciar():
    try:
        with open(PREFERENCIA) as f:
            return "autostart=false" not in f.read()
    except OSError:
        return True


def gravar_mostrar_ao_iniciar(sim):
    os.makedirs(os.path.dirname(PREFERENCIA), exist_ok=True)
    with open(PREFERENCIA, "w") as f:
        f.write("autostart=true\n" if sim else "autostart=false\n")


def instalado(como):
    tipo, nome = como
    if tipo == "deb":
        r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", nome], capture_output=True, text=True)
        return "install ok installed" in r.stdout
    r = subprocess.run(["flatpak", "info", nome], capture_output=True)
    return r.returncode == 0


def logitech_conectado():
    base = "/sys/bus/usb/devices"
    try:
        for d in os.listdir(base):
            try:
                with open(os.path.join(base, d, "idVendor")) as f:
                    if f.read().strip() == "046d":
                        return True
            except OSError:
                pass
    except OSError:
        pass
    return False


def tema_escuro():
    r = subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"],
                       capture_output=True, text=True)
    return r.stdout.strip() == TEMA_ESCURO


def aplicar_tema(escuro):
    tema = TEMA_ESCURO if escuro else TEMA_CLARO
    subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", tema])
    subprocess.run(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", tema])
    # programas GNOME e flatpak leem o gsettings
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", tema])
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
                    "prefer-dark" if escuro else "default"])


def rotulo(texto, classe=None, **kw):
    l = Gtk.Label(label=texto, **kw)
    if classe:
        l.get_style_context().add_class(classe)
    return l


