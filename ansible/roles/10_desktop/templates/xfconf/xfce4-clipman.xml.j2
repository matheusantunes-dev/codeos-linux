<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }}
     Histórico da área de transferência (Super+V) só na memória, como no Windows: some ao sair da sessão
     em vez de ficar gravado em ~/.cache/xfce4/clipman (senhas e tokens copiados iam parar no disco). -->
<channel name="xfce4-clipman" version="1.0">
  <property name="settings" type="empty">
    <property name="save-on-quit" type="bool" value="false"/>
  </property>
</channel>
