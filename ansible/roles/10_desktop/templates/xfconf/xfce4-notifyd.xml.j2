<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }}
     Notificações no canto inferior direito, acima do relógio, deslizando para dentro e para fora. -->
<channel name="xfce4-notifyd" version="1.0">
  <property name="notify-location" type="uint" value="3"/>
  <property name="initial-opacity" type="double" value="0.960000"/>
  <property name="do-slideout" type="bool" value="true"/>
  <property name="do-fadeout" type="bool" value="true"/>
  <property name="expire-timeout" type="int" value="6"/>
  <property name="notification-log" type="bool" value="true"/>
  <property name="log-level" type="uint" value="0"/>
  <property name="theme" type="string" value="Default"/>
</channel>
