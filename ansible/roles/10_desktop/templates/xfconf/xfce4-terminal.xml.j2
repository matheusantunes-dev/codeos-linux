<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }}
     Terminal com a paleta do CodeOS (ciano do logo), JetBrains Mono e fundo preto sólido. -->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="JetBrains Mono 11"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#E6EDF7"/>
  <property name="color-background" type="string" value="#000000"/>
  <property name="color-cursor" type="string" value="#05C0DF"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-bold-is-bright" type="bool" value="true"/>
  <property name="color-palette" type="string" value="#1B2440;#FF5C7A;#4FD18B;#F5C26B;#3A6FD2;#B48CFF;#05C0DF;#C9D4E8;#3B4A70;#FF7F96;#7BE3A8;#FFD58A;#5F8FEA;#C9A8FF;#5FD8EC;#FFFFFF"/>
  <property name="background-mode" type="string" value="TERMINAL_BACKGROUND_SOLID"/>
  <property name="misc-cursor-shape" type="string" value="TERMINAL_CURSOR_SHAPE_IBEAM"/>
  <property name="misc-cursor-blinks" type="bool" value="true"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-default-geometry" type="string" value="110x30"/>
  <property name="scrolling-unlimited" type="bool" value="true"/>
  <property name="title-mode" type="string" value="TERMINAL_TITLE_REPLACE"/>
</channel>
