#!/bin/sh
# Alt+F4 como no Windows: fecha a janela em foco; na área de trabalho (ou sem janela em foco),
# abre as opções de sair, reiniciar, desligar, suspender e trocar de usuário.
ativa=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $5}' | tr -d ,)
if [ -n "$ativa" ] && [ "$ativa" != "0x0" ] &&
   ! xprop -id "$ativa" _NET_WM_WINDOW_TYPE 2>/dev/null | grep -q -e _NET_WM_WINDOW_TYPE_DESKTOP -e _NET_WM_WINDOW_TYPE_DOCK; then
    exec wmctrl -i -c "$ativa"
fi
exec xfce4-session-logout
