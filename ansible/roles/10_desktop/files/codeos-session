#!/bin/sh
# Sessão CodeOS (Exec do /usr/share/xsessions/codeos.desktop). O picom sobe antes do Xfce: a barra
# nasce invisível e só aparece inteira (módulo da barra), o que precisa do compositor já rodando.
#
# Modo do picom pela placa de vídeo desta máquina (a mesma ISO roda em qualquer PC): glx (pela GPU) nas
# placas atuais; xrender (pela CPU) nas antigas e nas máquinas virtuais. Com xrender numa placa atual o
# Xorg ficava ocupado desenhando as janelas pela CPU e a tela travava; com glx numa placa antiga (Intel
# HD 4000, driver crocus) menus e janelas saíam transparentes. Um ~/.config/picom/picom.conf da
# pessoa manda no modo dele.
backend=xrender
case "$(xdriinfo driver 0 2>/dev/null)" in
    iris|radeonsi) backend=glx ;;
    "") [ -d /proc/driver/nvidia/gpus ] && backend=glx ;;  # NVIDIA como placa principal (sem DRI)
esac
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/picom/picom.conf" ]; then
    picom -b
else
    picom -b --backend "$backend"
fi
exec startxfce4
