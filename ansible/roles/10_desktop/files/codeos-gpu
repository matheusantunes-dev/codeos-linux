#!/bin/bash
# Abre um programa na placa de vídeo certa (notebook com Intel + NVIDIA no modo on-demand do PRIME).
#
#   codeos-gpu [--auto|--nvidia|--intel] programa [argumentos...]
#
# --auto (padrão, ou CODEOS_GPU=auto|nvidia|intel): na tomada abre na NVIDIA, na bateria na Intel.
# É a ideia do "deixar o sistema decidir" do Windows/NVIDIA Optimus: a placa é escolhida quando o
# programa abre (um contexto gráfico não troca de placa depois de criado). Na tomada, com monitor
# externo, a NVIDIA em geral já está acordada (a saída HDMI do Nitro é dela), então quase não gasta a
# mais; na bateria a Intel economiza.
#
# Sem NVIDIA carregada, ou sem Intel junto (só uma placa), abre o programa do jeito normal.
set -u

modo=${CODEOS_GPU:-auto}
case ${1:-} in
    --auto|--nvidia|--intel) modo=${1#--}; shift ;;
esac
[ $# -gt 0 ] || { echo "uso: codeos-gpu [--auto|--nvidia|--intel] programa [argumentos...]" >&2; exit 2; }

na_tomada() {
    local s
    for s in /sys/class/power_supply/*; do
        [ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && return 0
    done
    # sem bateria nenhuma (computador de mesa) conta como na tomada
    ! grep -qx Battery /sys/class/power_supply/*/type 2>/dev/null
}

# offload só faz sentido com o driver da NVIDIA carregado e outra placa fazendo a tela (PRIME)
tem_offload() {
    compgen -G '/proc/driver/nvidia/gpus/*' >/dev/null || return 1
    local placas
    placas=$(ls -d /sys/class/drm/card[0-9]* 2>/dev/null | grep -cv -- '-')
    [ "$placas" -ge 2 ]
}

if [ "$modo" = auto ]; then
    if na_tomada; then modo=nvidia; else modo=intel; fi
fi

if [ "$modo" = nvidia ] && tem_offload; then
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
    # o Firefox desenha por EGL no X11: sem isto o EGL continua na Intel
    egl=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
    [ -f "$egl" ] && export __EGL_VENDOR_LIBRARY_FILENAMES=$egl
fi

exec "$@"
