    productUrl:          https://github.com/matheusantunes-dev
    supportUrl:          https://github.com/matheusantunes-dev

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            1

style:
   SidebarBackground:        "#0A1B3C"
   SidebarText:              "#E6EDF7"
   SidebarTextCurrent:       "#05C0DF"
   SidebarBackgroundCurrent: "#13295A"
